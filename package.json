{
  "name": "mbzr",
  "version": "2.0.2.4",
  "description": "Mahmood Bawazir's personal site",
  "scripts": {
    "start": "concurrently \"npm run start:webpack\" \"npm run start:hugo\"",
    "start:hugo": "hugo -d dist -vw",
    "start:webpack": "cross-env NODE_ENV=development webpack-dev-server --config webpack.config.js --hot",
    "preview": "concurrently \"npm run preview:webpack\" \"npm run preview:hugo\"",
    "preview:hugo": "npm run start:hugo -- -D -F",
    "preview:webpack": "npm run start:webpack",
    "prebuild": "rimraf dist",
    "build": "npm run build:webpack && npm run build:hugo",
    "build:preview": "npm run build:webpack && npm run build:hugo:preview",
    "build:hugo": "hugo -d dist --gc --minify",
    "build:hugo:preview": "npm run build:hugo -- -D -F",
    "build:webpack": "cross-env NODE_ENV=production webpack"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mbzr/mbzr.dev.git"
  },
  "author": "Mahmood Bawazir",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/mbzr/mbzr.dev/issues"
  },
  "homepage": "https://github.com/mbzr/mbzr.dev#readme",
  "dependencies": {
    "animejs": "^3.2.2",
    "normalize.css": "^8.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-transform-arrow-functions": "^7.24.7",
    "@babel/plugin-transform-class-properties": "^7.24.7",
    "@babel/preset-env": "^7.25.3",
    "assets-webpack-plugin": "^7.1.1",
    "babel-loader": "^9.1.3",
    "clean-webpack-plugin": "^4.0.0",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "css-loader": "^7.1.2",
    "css-minimizer-webpack-plugin": "^7.0.0",
    "html-webpack-plugin": "^5.6.0",
    "image-webpack-loader": "^8.1.0",
    "mini-css-extract-plugin": "^2.9.0",
    "rimraf": "^6.0.1",
    "sass": "^1.77.8",
    "sass-loader": "^16.0.0",
    "style-loader": "^4.0.0",
    "terser-webpack-plugin": "^5.3.10",
    "webpack": "^5.93.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.0.4",
    "webpack-merge": "^6.0.1",
    "webpack-stream": "^7.0.0"
  }
}
